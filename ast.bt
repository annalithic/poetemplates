typedef struct {
    float x;
    float y;
    float z;
}vec3 <read=vec3Read>;

string vec3Read(vec3& v) {
    string str;
    SPrintf(str, "%f %f %f  (%f)", v.x, v.y, v.z, Sqrt(v.x * v.x + v.y * v.y + v.z * v.z));
    return str;
}

typedef struct {
    float x;
    float y;
    float z;
    float w;
}vec4 <read=vec4Read>;

string vec4Read(vec4& v) {
    string str;
    SPrintf(str, "%f %f %f %f", v.x, v.y, v.z, v.w);
    return str;
}


typedef struct (int version) {
    byte sibling;
    byte child;
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 d;
    byte nameLength;
    if(version > 7) byte unkasdas;
    char name[nameLength] <bgcolor=cDkGreen>;
}Joint <read=JointRead>;

string JointRead(Joint& joint) {
    return joint.name;
}

typedef struct (int version){
    byte nameLength;
    byte unk[55];
    if(version > 8) int unk2;
    char name[nameLength] <bgcolor=cDkYellow>;
}Light <read=LightRead>;

string LightRead(Light& light) {
    return light.name;
}


typedef struct (int version){
    ubyte tracks;
    byte unk1;
    byte framerate;
    byte unk2;
    if(version >= 10) {
        byte unk3;
    }
    byte nameLength;
    if(version > 10) {
        byte parentNameLength;
    }
    if(version > 7) {
        byte unk4[8];
    }
    char name[nameLength] <bgcolor=cDkAqua>;
    if(version > 10) {
        char parentName[parentNameLength] <bgcolor=cAqua>;
    }
}Animation <read=AnimationRead>;

string AnimationRead(Animation& animation) {
    return animation.name;
}



byte version;
ubyte jointCount;
byte unk1;
ubyte animationCount;
byte unk2[3];
byte lightCount;

struct {
    Joint joints(version)[jointCount] <optimize=false>;
} joints;

Light lights(version)[lightCount] <optimize=false>;

Animation animations(version)[animationCount] <optimize=false>;

typedef struct {
    float t;
    float x;
    float y;
    float z;
} vecKey;

typedef struct {
    float t;
    float x;
    float y;
    float z;
    float w;
} quatKey;

typedef struct (Animation& a, byte version) {
    byte unk1;
    int bone;
    int scalesCount;
    int rotationsCount;
    int positionsCount;
    int scalesCount2;
    int rotationsCount2;
    int positionsCount2;
    if(version > 10) {
        int unk2;
    }
    vecKey scales[scalesCount];
    quatKey rotations[rotationsCount];
    vecKey positions[positionsCount];
    vecKey scales2[scalesCount2];
    quatKey rotaions2[rotationsCount2];
    vecKey positions2[positionsCount2];
} Track;

struct AnimationTracks(Animation& a, byte version) {
    local int i = 0;
    for(i = 0; i < a.tracks; i++) {
        Track track(a, version);
    }
    
};
